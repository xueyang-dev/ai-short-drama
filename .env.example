# Local OpenAI-compatible LLM (script and storyboard text)
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=

# Existing ComfyUI is HTTP-only. The application must never mutate its environment.
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_REQUEST_TIMEOUT_MS=30000

# Independent local workers (never reuse ComfyUI Python/PyTorch)
NAMAA_BASE_URL=http://127.0.0.1:8189
NAMAA_MODEL=
MUSETALK_BASE_URL=http://127.0.0.1:8190

# Local FFmpeg executable
FFMPEG_PATH=ffmpeg

# 可选：数据目录。默认使用项目下的 data/
# DATA_DIR=C:\\ai-short-drama-data
