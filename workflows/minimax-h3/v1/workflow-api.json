{
  "1": {
    "class_type": "MiniMaxH3EasyLoader",
    "inputs": {
      "fl2va_model": "{{FL2VA_MODEL}}",
      "ref2va_model": "{{REF2VA_MODEL}}",
      "text_encoder": "MiniMax-H3/qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "video_vae": "MiniMax-H3/minimax_h3_video_vae_int8_convrot.safetensors",
      "audio_vae": "MiniMax-H3/minimax_h3_audio_vae_fp32.safetensors"
    }
  },
  "2": {
    "class_type": "MiniMaxH3Easy",
    "inputs": {
      "h3_bundle": ["1", 0],
      "media": ["14", 0],
      "mode": "{{MODE}}",
      "prompt": "{{PROMPT}}",
      "resolution": "custom",
      "aspect_ratio": "9:16",
      "width": 768,
      "height": 1280,
      "seconds": 5,
      "advanced": false,
      "fps": 24,
      "keyframe_role": "first",
      "ref_image_size": "original",
      "reference_mention_mode": "index",
      "prompt_optimizer_settings": false,
      "prompt_optimizer_scene_guide": "none"
    }
  },
  "4": { "class_type": "BasicGuider", "inputs": { "model": ["34", 0], "conditioning": ["13", 0] } },
  "5": { "class_type": "BasicScheduler", "inputs": { "model": ["34", 0], "scheduler": "beta", "steps": 4, "denoise": 1 } },
  "6": { "class_type": "RandomNoise", "inputs": { "noise_seed": 0 } },
  "7": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "euler" } },
  "8": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": { "noise": ["6", 0], "guider": ["4", 0], "sampler": ["7", 0], "sigmas": ["5", 0], "latent_image": ["13", 1] }
  },
  "9": { "class_type": "VAEDecode", "inputs": { "samples": ["8", 0], "vae": ["13", 2] } },
  "10": { "class_type": "VAEDecodeAudio", "inputs": { "samples": ["8", 1], "vae": ["13", 3] } },
  "11": { "class_type": "CreateVideo", "inputs": { "images": ["9", 0], "audio": ["10", 0], "fps": ["13", 4] } },
  "12": { "class_type": "SaveVideo", "inputs": { "video": ["11", 0], "filename_prefix": "ai-short-drama/h3", "format": "auto", "codec": "auto" } },
  "13": { "class_type": "MiniMaxH3EasyOutput", "inputs": { "h3_context": ["2", 1] } },
  "14": { "class_type": "MiniMaxH3EasyMediaBridge", "inputs": { "image_count": 1, "video_count": 0, "audio_count": 0, "image_1": ["100", 0] } },
  "24": { "class_type": "LoraLoaderModelOnly", "inputs": { "model": ["2", 0], "lora_name": "{{LORA}}", "strength_model": 1 } },
  "34": { "class_type": "ModelAttentionBackend", "inputs": { "model": ["24", 0], "attention": "comfy kitchen attention" } },
  "100": { "class_type": "LoadImage", "inputs": { "image": "{{REFERENCE_IMAGE}}" } }
}
